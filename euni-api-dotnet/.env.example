# Cổng/host: mặc định giống mock Node để euni-admin / euni-public không phải đổi cấu hình
PORT=3000
HOST=127.0.0.1
# Tiền tố khi tích hợp qua API gateway; API nhận cả URL có và không có tiền tố
BASE_PATH=/euni-mock-api
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h

# ---- PostgreSQL (nguồn dữ liệu DUY NHẤT lúc chạy) ----
# Ứng dụng: role cms_app (NOBYPASSRLS) — mọi request nghiệp vụ, bị Row-Level Security theo tenant
DATABASE_URL=Host=127.0.0.1;Port=5432;Database=euni_cms;Username=cms_app;Password=cms_app_dev
# Bảo trì: role cms_admin (BYPASSRLS) — áp lược đồ, nạp dữ liệu mẫu khi DB trống, sao lưu/phục hồi, /dev/reset
DATABASE_ADMIN_URL=Host=127.0.0.1;Port=5432;Database=euni_cms;Username=cms_admin;Password=cms_admin_dev
# DB_MIGRATE=false  → không tự áp lược đồ khi khởi động (DBA tự chạy database/cms-api/schema.sql)
API_LOG=true
