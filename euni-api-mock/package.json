{
  "name": "euni-api-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HUMG eUni — mock API gateway (CMS API + các service ngoài) để FE chạy khi chưa có backend",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "reset": "node scripts/reset.mjs",
