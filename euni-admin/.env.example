# API gateway: dev (mock) http://127.0.0.1:3000 · demo thật https://api-gateway-demo.humg.edu.vn
NEXT_PUBLIC_API_GATEWAY_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_TIMEOUT=15000
NEXT_PUBLIC_API_LOG=false
# URL hai app (link /cms chuyển sang admin; link công khai/portal chuyển sang public)
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# SSO Microsoft 365: entra = đăng nhập trực tiếp Microsoft Entra ID (mặc định) | keycloak = qua SSO HUMG (Keycloak)
NEXT_PUBLIC_SSO_ENABLED=true
NEXT_PUBLIC_SSO_PROVIDER=entra
NEXT_PUBLIC_SSO_TENANT_ID=c852d62b-3032-4cdc-96ab-30e4368fabd7
# Application (client) ID của app Azure — loại SPA, Redirect URI: {origin}/dang-nhap/sso/callback
NEXT_PUBLIC_SSO_CLIENT_ID=5a7cce06-4b5c-4612-b1fa-0ef7f0702a27
# Scope API của backend (vd. api://<app-id>/access_as_user); để trống → dùng id_token làm Bearer
# NEXT_PUBLIC_SSO_API_SCOPE=
# Chỉ khi PROVIDER=keycloak:
# NEXT_PUBLIC_SSO_ISSUER=https://sso-demo.humg.edu.vn/realms/humg-euni
# NEXT_PUBLIC_SSO_IDP_HINT=entra-public
