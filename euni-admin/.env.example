# API gateway — mọi lời gọi là `${NEXT_PUBLIC_API_GATEWAY_URL}/<service>/api/v1/...` (ghép chuỗi, giữ nguyên tiền tố của base URL):
#   dev (mock chạy máy):          http://127.0.0.1:3000
#   mock trên server (qua gateway): https://api-gateway-demo.humg.edu.vn/euni-mock-api
#   backend thật:                 https://api-gateway-demo.humg.edu.vn
NEXT_PUBLIC_API_GATEWAY_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_TIMEOUT=15000
NEXT_PUBLIC_API_LOG=false
# URL hai app (link /cms chuyển sang admin; link công khai/portal chuyển sang public)
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Tenant mặc định khi chưa chọn (CMS cho chọn trang quản trị theo claim tenant của tài khoản)
NEXT_PUBLIC_DEFAULT_TENANT=humg
# ---------------- Đăng nhập (docs/design/CMS_DESIGN.md §3) ----------------
# mock = dev: "Tài khoản trường" là form gọi auth-api của euni-api-mock (đóng vai Identity Server)
# oidc = mọi đăng nhập đi qua Identity Server; app không nhận mật khẩu
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_SSO_ENABLED=true
# ids = Identity Server HUMG (khuyến nghị: tài khoản trường + Microsoft 365 trên cùng một trang, cùng một sub)
# keycloak = Keycloak HUMG · entra = (cũ) đăng nhập thẳng Microsoft Entra ID, chỉ có nút Microsoft 365
NEXT_PUBLIC_SSO_PROVIDER=entra
# Khi PROVIDER=ids|keycloak: issuer (endpoint lấy qua /.well-known/openid-configuration)
# NEXT_PUBLIC_SSO_ISSUER=https://id.humg.edu.vn
# NEXT_PUBLIC_SSO_CLIENT_ID=humg-euni-web
# Nút "Microsoft 365" gửi gợi ý để IdS chuyển thẳng sang Entra ID (Duende: acr_values=idp:<scheme>; Keycloak: kc_idp_hint=<alias>)
# NEXT_PUBLIC_SSO_M365_PARAM=acr_values
# NEXT_PUBLIC_SSO_M365_VALUE=idp:Microsoft
# Scope API của backend (access token aud=cms-api). Để trống → dùng id_token làm Bearer (chỉ để thử nghiệm)
# NEXT_PUBLIC_SSO_API_SCOPE=cms-api
# Đăng ký trên IdS/Entra: Redirect URI {origin}/dang-nhap/sso/callback · Post-logout redirect URI {origin}/dang-nhap
# Khi PROVIDER=entra (Redirect URI loại SPA: {origin}/dang-nhap/sso/callback)
NEXT_PUBLIC_SSO_TENANT_ID=c852d62b-3032-4cdc-96ab-30e4368fabd7
NEXT_PUBLIC_SSO_CLIENT_ID=5a7cce06-4b5c-4612-b1fa-0ef7f0702a27
